# Copy to .env in this folder. Never commit the real key.
GEMINI_API_KEY=
# Optional override. Default is gemini-3.5-flash-lite (highest free-tier daily limit).
# GEMINI_MODEL=gemini-3.5-flash-lite
# Seconds between Gemini calls. Default 1.0 (paid). Use 4.5 on free-tier (~15 RPM).
# 429 retries back off automatically either way. Token/credit use is unchanged.
# GEMINI_MIN_INTERVAL_SEC=1.0
